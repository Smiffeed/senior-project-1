{
  "model_config": {
    "base_model_name": "airesearch/wav2vec2-large-xlsr-53-th",
    "num_labels": 9,
    "hidden_dim": 768,
    "additional_feature_dim": 128
  },
  "training_config": {
    "num_folds": 5,
    "batch_size": 8,
    "val_batch_size": 16,
    "learning_rate": 3e-05,
    "weight_decay": 0.01,
    "num_epochs": 30,
    "early_stopping_patience": 5,
    "gradient_clipping": 1.0
  },
  "advanced_features": {
    "use_spectral_augmentation": true,
    "use_contrastive_learning": true,
    "use_meta_learning": false,
    "use_adversarial_training": true,
    "use_ensemble": false,
    "use_knowledge_distillation": false,
    "use_progressive_training": false,
    "use_curriculum_learning": true,
    "use_mixup_augmentation": true,
    "use_focal_loss": false,
    "use_uncertainty_estimation": true
  },
  "loss_weights": {
    "contrastive_weight": 0.1,
    "adversarial_weight": 0.2,
    "knowledge_distillation_weight": 0.3,
    "focal_loss_alpha": 1.0,
    "focal_loss_gamma": 2.0,
    "auxiliary_loss_weight": 0.1
  },
  "augmentation_config": {
    "audio_augmentation": {
      "time_mask_rate": 0.1,
      "freq_mask_rate": 0.15,
      "num_masks": 2,
      "noise_level": 0.005,
      "pitch_shift_range": [
        -300,
        300
      ],
      "speed_change_range": [
        0.8,
        1.2
      ],
      "apply_probability": 0.7
    },
    "spectral_augmentation": {
      "spec_augment_probability": 0.8,
      "mixup_alpha": 0.4,
      "mixup_probability": 0.5
    }
  },
  "preprocessing_config": {
    "sample_rate": 16000,
    "max_length": 16000,
    "apply_pre_emphasis": true,
    "pre_emphasis_coeff": 0.97,
    "apply_noise_reduction": true,
    "apply_hamming_window": true,
    "apply_normalization": true,
    "extract_additional_features": true
  },
  "feature_extraction": {
    "n_mels": 128,
    "n_mfcc": 13,
    "hop_length": 512,
    "win_length": 1024,
    "extract_spectral_features": true,
    "extract_temporal_features": true,
    "extract_prosodic_features": true
  },
  "curriculum_learning": {
    "enabled": true,
    "total_epochs": 100,
    "easy_stage_ratio": 0.7,
    "difficulty_factors": {
      "label_frequency": 0.7,
      "segment_duration": 0.3
    }
  },
  "ensemble_config": {
    "num_models": 5,
    "voting_strategy": "soft",
    "uncertainty_weighting": true,
    "diversity_penalty": 0.1
  },
  "optimization": {
    "optimizer": "AdamW",
    "scheduler": "CosineAnnealingLR",
    "warmup_steps": 1000,
    "gradient_accumulation_steps": 1,
    "mixed_precision": true
  },
  "evaluation_config": {
    "metrics": [
      "accuracy",
      "precision",
      "recall",
      "f1_score",
      "confusion_matrix",
      "roc_auc",
      "uncertainty_analysis",
      "calibration_error"
    ],
    "per_class_analysis": true,
    "error_analysis": true,
    "generate_plots": true,
    "save_predictions": true
  },
  "data_config": {
    "train_test_split": 0.9,
    "stratify": true,
    "oversample_minority": true,
    "undersample_majority": false,
    "minimum_samples_per_class": 10
  },
  "hardware_config": {
    "use_gpu": true,
    "num_workers": 2,
    "pin_memory": true,
    "deterministic": true,
    "benchmark": false
  },
  "logging_config": {
    "log_level": "INFO",
    "log_interval": 100,
    "save_checkpoints": true,
    "checkpoint_interval": 5,
    "tensorboard_logging": false,
    "wandb_logging": false
  },
  "output_config": {
    "base_output_dir": "./models/advanced_audio_train",
    "save_best_model": true,
    "save_all_folds": true,
    "save_ensemble": true,
    "export_onnx": false,
    "export_torchscript": false
  }
}